{
  "name": "exim-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run test:unit && npm run test:regression",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "test:regression": "node tests/regression/port-arrival.regression.cjs && node --test \"tests/regression/*.test.cjs\"",
    "db:schema-check": "node -e \"process.exit(require('./tests/regression/dmmf.cjs')()?0:1)\""
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@prisma/prisma-schema-wasm": "7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "@types/node": "^22.0.0",
    "@types/react": "latest",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
