// =============================================================================
// EXIM ERP — Prisma schema (MySQL 8)
// Domains: core · reference · sourcing · warehouse · compliance · logistics
//          · customs · finance · audit
//
// Conventions
//   • Masters/documents: Int autoincrement PK. High-volume append-only logs: BigInt PK.
//   • Money: Decimal(18,2) amounts · Decimal(18,4) unit prices/costs · Decimal(18,6) FX
//   • Quantity Decimal(18,3) · Weight Decimal(14,3) · Rates (percent) Decimal(7,4)
//   • Currency columns are CHAR(3) ISO-4217 and FK -> Currency.code (types must match for MySQL FKs)
//   • *Event / *History / AuditLog tables are APPEND-ONLY (never UPDATE/DELETE from app code)
//   • Functional (base) currency is INR; *Inr columns are always INR.
//   • Shipment.version is an optimistic-lock counter; always update via updateMany({ where: { id, version } })
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

